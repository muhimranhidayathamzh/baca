# OpenAlex — daftar gratis di openalex.org/settings/api
# Boleh dikosongkan saat dev: tanpa key, app tetap jalan lewat "polite pool"
# (pakai mailto) dengan kuota ~1.000 request/hari per IP. Untuk produksi key ini
# praktis wajib. Catatan: key yang SALAH bikin OpenAlex balas 401 — lebih baik
# dikosongkan sekalian daripada diisi ngawur.
OPENALEX_API_KEY=

# Google Gemini API — dari aistudio.google.com/apikey (gratis, tanpa kartu kredit)
GEMINI_API_KEY=

# OPSIONAL — nama model Gemini. Kosongkan untuk memakai default "gemini-2.5-flash".
# Isi manual kalau default-nya sudah dipensiunkan Google atau mau coba model lain.
GEMINI_MODEL=

# Supabase — server-side only, dari project settings > API
# Gunakan service_role key, BUKAN anon key (semua akses lewat API routes)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Upstash Redis — untuk rate limiting, dari upstash.com console
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPSIONAL — untuk upgrade ke Claude API nanti jika mau kualitas lebih tinggi
# ANTHROPIC_API_KEY=
