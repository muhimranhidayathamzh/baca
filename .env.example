# OpenAlex — daftar gratis di openalex.org/settings/api
OPENALEX_API_KEY=

# Google Gemini API — dari aistudio.google.com/apikey (gratis, tanpa kartu kredit)
GEMINI_API_KEY=

# Supabase — server-side only, dari project settings > API
# Gunakan service_role key, BUKAN anon key (semua akses lewat API routes)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Upstash Redis — untuk rate limiting, dari upstash.com console
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPSIONAL — untuk upgrade ke Claude API nanti jika mau kualitas lebih tinggi
# ANTHROPIC_API_KEY=
