# Upstash Redis — WAJIB di produksi. Dari console.upstash.com → Create Database
# (Redis) → bagian REST API. Dipakai untuk rate limiting, cache ringkasan AI,
# batas harian AI, dan metrik anonim. Tanpa ini, di produksi semua API route
# membalas 429 (sengaja: rate limiting gagal-tertutup). Saat dev boleh kosong.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini API — dari aistudio.google.com/apikey (ada free tier)
GEMINI_API_KEY=

# OPSIONAL — nama model Gemini. Kosongkan untuk memakai default
# "gemini-3.5-flash-lite". Isi manual kalau mau model lain (mis.
# "gemini-3.8-flash" untuk hook yang lebih luwes, tapi lebih lambat & mahal).
GEMINI_MODEL=

# OPSIONAL — batas panggilan AI per hari untuk SEMUA user (default 1000).
# Menjaga kuota Gemini tidak habis/tagihan tidak meledak karena segelintir IP.
# Sesuaikan dengan batas free tier di aistudio.google.com/rate-limit.
AI_DAILY_LIMIT=

# OPSIONAL — batas panggilan AI per MENIT untuk semua user (default 12).
# Free tier Gemini menolak lebih dari 15 request/menit per model; 12 memberi
# sisa ruang. Naikkan (mis. 300) kalau billing Gemini sudah diaktifkan.
AI_RPM_LIMIT=

# OpenAlex — daftar di openalex.org/settings/api
# Boleh dikosongkan saat dev: tanpa key, app tetap jalan lewat "polite pool"
# dengan kuota $0,10/hari (1.000 kredit) per IP. Key gratis menaikkannya ke
# $1/hari (10.000 kredit). Satu halaman feed = 1 kredit, satu search = 10.
# Untuk produksi key ini praktis wajib: IP Vercel dipakai bersama banyak app.
# Key yang SALAH bikin OpenAlex balas 401 — lebih baik kosong daripada ngawur.
OPENALEX_API_KEY=

# OPSIONAL — token rahasia untuk membaca metrik di GET /api/stats
# (header "Authorization: Bearer <token>"). Kosong = endpoint dimatikan (404).
# Buat string acak panjang, mis. hasil `openssl rand -hex 32`.
STATS_TOKEN=

# OPSIONAL — untuk upgrade ke Claude API nanti jika mau kualitas lebih tinggi
# ANTHROPIC_API_KEY=
